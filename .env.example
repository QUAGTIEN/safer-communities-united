# Take Action forms (S7). Set these in Vercel → Settings → Environment Variables; never commit real values.
# simulate (default): validate and answer without sending. live: email each submission through Resend.
FORMS_MODE=simulate
# Resend API key (server only).
RESEND_API_KEY=
# Verified sender, e.g. "Safer Communities United <forms@your-domain.org>".
# Without a verified domain Resend only allows "onboarding@resend.dev" to the Resend account owner's address.
FORMS_SENDER=
# Fixed recipient. Use a test inbox while testing; the blueprint recipient only after launch approval.
FORMS_RECIPIENT=
